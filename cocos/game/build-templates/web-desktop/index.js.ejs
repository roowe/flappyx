import { Application } from '<%= applicationJS %>';

const application = new Application();
System.import('cc').then(engine => {
  // Creator 3.8 reads this from settings; the legacy HTML attribute alone has no effect.
  engine.game.onPostBaseInitDelegate.add(() => {
    engine.settings.overrideSettings('screen', 'exactFitScreen', true);
  });
  return application.init(engine);
}).then(() => application.start()).catch(error => console.error(error));
