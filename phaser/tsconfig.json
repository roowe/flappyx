{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "types": ["vite/client", "bun"],
    "strict": true, "noEmit": true, "resolveJsonModule": true, "esModuleInterop": true,
    "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src", "tests", "scripts", "vite.config.ts", "../shared/core-ts/**/*.ts"]
}
