{
  "schemaVersion": 1,
  "baselineStatus": "provisionalUntilPhaserPlaytest",
  "canvas": {"width": 1024, "height": 768, "origin": "topLeft", "yAxis": "down", "scaleMode": "fitWithLetterbox"},
  "simulation": {"tickRate": 30, "maxCatchUpTicks": 5, "numericType": "float64", "positionTolerance": 0.001, "overflowTimePolicy": "discardWholeTicksKeepFraction"},
  "bird": {
    "x": 350,
    "initialY": 464,
    "displayWidth": 85,
    "displayHeight": 60,
    "flapVelocityPerTick": -13.5,
    "gravityPerTickSquared": 1.5,
    "hitbox": {"width": 64, "height": 44, "offsetX": 0, "offsetY": 0},
    "animationId": "bird.flap"
  },
  "ground": {"topY": 544, "height": 224, "scrollPerTick": 8, "spriteId": "background.land"},
  "sky": {"scrollPerTick": 2, "spriteId": "background.sky"},
  "pipes": {
    "width": 75,
    "headHeight": 50,
    "gapHeight": 200,
    "spacing": 190,
    "scrollPerTick": 8,
    "firstCenterX": 1224,
    "topClearance": 30,
    "bottomClearance": 10,
    "gapCenterMin": 180,
    "gapCenterMax": 384,
    "activeCount": 7,
    "upperHeadSpriteId": "pipe.upper.head",
    "upperBodySpriteId": "pipe.upper.body",
    "lowerHeadSpriteId": "pipe.lower.head",
    "lowerBodySpriteId": "pipe.lower.body"
  },
  "rules": {
    "firstFlapStartsAndFlaps": true,
    "flapResetsVelocity": true,
    "maxFlapsPerTick": 1,
    "movementOrder": "positionThenGravity",
    "collisionBeforeScore": true,
    "collisionPriority": ["ground", "ceiling", "upperPipe", "lowerPipe"],
    "pipeCollisionShape": "axisAlignedHitbox",
    "pipeTouchIsCollision": true,
    "floorAndCeilingShape": "unrotatedDisplayBounds",
    "scoreWhen": "pipeRightStrictlyLessThanHitboxLeft",
    "recycleWhen": "pipeRightStrictlyLessThanZero",
    "restartTarget": "ready",
    "restartInputFlaps": false,
    "restartResetsTick": true
  },
  "death": {"gravityPerTickSquared": 15, "entryVelocityPerTick": 0, "restartGuardTicks": 15, "guardStartsAt": "deathTick"},
  "random": {"algorithm": "xorshift32", "defaultSeed": 123456789, "zeroSeedPolicy": "reject", "gapMapping": "minPlusUint32ModuloInclusiveRange"},
  "lifecycle": {"pauseOnBlur": true, "requireExplicitResume": true, "clearAccumulatedTimeOnResume": true},
  "storage": {"schemaVersion": 1, "keyPrefix": "flappyx", "fields": ["schemaVersion", "bestScore"], "writeBestScoreOn": "gameOver"},
  "render": {"clearColor": "#51c0c9", "filter": "nearest", "mipmaps": false, "rotationAffectsCollision": false}
}
